<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Admin' }) %></head>
<body>
<%- include('partials/nav', { user }) %>
  <div class="page page-wide">
    <div class="card">
      <h1>Admin Panel</h1>
        <div class="table-wrap">
          <table>
            <tr><th>ID</th><th>Username</th><th>Balance</th><th>Update</th></tr>
            <% users.forEach(u => { %>
              <tr>
                <td><%= u.id %></td><td><%= u.username %></td><td><%= u.balance %></td>
                <td>
                  <form action="/admin/update-balance" method="POST" class="inline-form">
                    <input type="hidden" name="userId" value="<%= u.id %>">
                    <input type="number" name="newBalance" placeholder="New balance">
                    <button type="submit">Update</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </table>
        </div>
    </div>
  </div>
</body>
</html>