<h1>Bet History</h1>
<table border="1">
  <tr>
    <th>Amount</th>
    <th>Choice</th>
    <th>Result</th>
    <th>Time</th>
  </tr>
  <% bets.forEach(bet => { %>
    <tr>
      <td><%= bet.amount %></td>
      <td><%= bet.choice %></td>
      <td><%= bet.result %></td>
      <td><%= bet.timestamp %></td>
    </tr>
  <% }) %>
</table>
<a href="/dashboard">Back to Dashboard</a>